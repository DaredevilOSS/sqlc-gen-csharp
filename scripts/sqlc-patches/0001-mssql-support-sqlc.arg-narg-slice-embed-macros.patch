From 3a7c93cd7a0895f3190327a297bbfac15df66ee8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 08:30:06 +0000
Subject: [PATCH 1/3] mssql: support sqlc.arg/narg/slice/embed macros

---
 internal/compiler/parse_core.go       | 43 +++++++++++++++++++++++++++
 internal/sql/preprocess/dialect.go    |  9 ++++++
 internal/sql/preprocess/preprocess.go |  5 ++++
 3 files changed, 57 insertions(+)

diff --git a/internal/compiler/parse_core.go b/internal/compiler/parse_core.go
index 2e1dfc704..091224415 100644
--- a/internal/compiler/parse_core.go
+++ b/internal/compiler/parse_core.go
@@ -64,6 +64,7 @@ func (c *Compiler) parseQueryCore(raw *ast.RawStmt, src string, pre *preprocess.
 		for _, col := range res.Columns {
 			cols = append(cols, coreColumn(col))
 		}
+		cols = collapseEmbeds(cols, res.Stars, pre.Embeds)
 		placeholders, err := placeholderNames(raw)
 		if err != nil {
 			return nil, err
@@ -211,3 +212,45 @@ func coreParamColumn(p core.Parameter, params *named.ParamSet) *Column {
 	}
 	return col
 }
+
+// collapseEmbeds replaces the columns a rewritten sqlc.embed() star expanded
+// to with a single column that references the embedded table.
+func collapseEmbeds(cols []*Column, stars []core.StarExpansion, embeds preprocess.EmbedSet) []*Column {
+	for _, star := range stars {
+		embed, ok := embeds.Find(star.Location)
+		if !ok {
+			continue
+		}
+		n := len(star.Columns)
+		if n == 0 {
+			continue
+		}
+		for i := 0; i+n <= len(cols); i++ {
+			if !matchesStar(cols[i:i+n], star) {
+				continue
+			}
+			// The embed names a table or an alias of it; the column
+			// references the table itself.
+			table := embed.Table
+			if src := cols[i].Table; src != nil {
+				table = src
+			}
+			rest := append([]*Column{{
+				Name:       table.Name,
+				EmbedTable: table,
+			}}, cols[i+n:]...)
+			cols = append(cols[:i], rest...)
+			break
+		}
+	}
+	return cols
+}
+
+func matchesStar(cols []*Column, star core.StarExpansion) bool {
+	for i, sc := range star.Columns {
+		if cols[i].EmbedTable != nil || cols[i].Name != sc.Name || cols[i].TableAlias != sc.Relation {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/sql/preprocess/dialect.go b/internal/sql/preprocess/dialect.go
index 4d8d4ae85..8c8e45456 100644
--- a/internal/sql/preprocess/dialect.go
+++ b/internal/sql/preprocess/dialect.go
@@ -14,6 +14,9 @@ const (
 	StyleQuestion
 	// StyleOrdinal numbers parameters as ?1, ?2, ... (SQLite)
 	StyleOrdinal
+
+	// StyleAtName writes parameters as @name (SQL Server)
+	StyleAtName
 )
 
 // Dialect describes the lexical rules the preprocessor needs to walk a query
@@ -88,6 +91,12 @@ var dialects = map[config.Engine]Dialect{
 		Backtick:  true,
 		Backslash: true,
 	},
+	// SQL Server binds by name with @name. Identifiers keep their case.
+	config.EngineMSSQL: {
+		Style:              StyleAtName,
+		AtSign:             true,
+		NestedBlockComment: true,
+	},
 	// ClickHouse binds with an unnumbered ?, like MySQL, and its identifiers
 	// keep their case.
 	config.EngineClickHouse: {
diff --git a/internal/sql/preprocess/preprocess.go b/internal/sql/preprocess/preprocess.go
index ad25bc9b2..1af0f074a 100644
--- a/internal/sql/preprocess/preprocess.go
+++ b/internal/sql/preprocess/preprocess.go
@@ -377,6 +377,11 @@ func (d Dialect) replacement(occ *occurrence) string {
 		return occ.ident
 	}
 	switch d.Style {
+	case StyleAtName:
+		if occ.kind == kindSlice {
+			return fmt.Sprintf("/*SLICE:%s*/@%s", occ.name, occ.name)
+		}
+		return "@" + occ.name
 	case StyleDollar:
 		// PostgreSQL passes a slice as a single array parameter, so it needs no
 		// expansion marker.
